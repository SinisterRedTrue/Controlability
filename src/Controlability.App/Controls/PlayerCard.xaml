<UserControl x:Class="Controlability.App.Controls.PlayerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:Controlability.App.Resources"
             xmlns:conv="clr-namespace:Controlability.App.Converters"
             AllowDrop="True" Focusable="True" IsTabStop="True"
             AutomationProperties.Name="{Binding AutomationName}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ControllerTypeToSymbolConverter x:Key="TypeToSymbol" />
        <Style x:Key="OptionMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
        </Style>
    </UserControl.Resources>
    <Border x:Name="Root" CornerRadius="8" BorderThickness="1" MinHeight="150" Margin="0,0,12,12"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{x:Static res:Strings.MenuIdentify}" Command="{Binding IdentifyCommand}" />
                <MenuItem Header="{x:Static res:Strings.MenuChangeProfile}" ItemsSource="{Binding ProfileOptions}"
                          IsEnabled="{Binding IsOccupied}" ItemContainerStyle="{StaticResource OptionMenuItemStyle}" />
                <MenuItem Header="{x:Static res:Strings.MenuUnassign}" Command="{Binding UnassignCommand}" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{Binding SlotColor}" CornerRadius="8,0,0,8" />
            <StackPanel Grid.Column="1" Margin="16,14,16,14">
                <Grid>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{x:Static res:Strings.SlotEmptyHint}" Margin="0,28,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding DeviceType, Converter={StaticResource TypeToSymbol}}"
                                       FontSize="32" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding BatteryText}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding XInputText}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding ProfileText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProfileText}" />
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
