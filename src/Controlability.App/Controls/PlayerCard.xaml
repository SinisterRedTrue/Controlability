<UserControl x:Class="Controlability.App.Controls.PlayerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:Controlability.App.Resources"
             xmlns:conv="clr-namespace:Controlability.App.Converters"
             AllowDrop="True" Focusable="True" IsTabStop="True"
             AutomationProperties.Name="{Binding AutomationName}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controlability;component/Resources/DashboardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ControllerTypeToSymbolConverter x:Key="TypeToSymbol" />
            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="Root" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{x:Static res:Strings.MenuIdentify}" Command="{Binding IdentifyCommand}" />
                <MenuItem Header="{x:Static res:Strings.MenuChangeProfile}" ItemsSource="{Binding ProfileOptions}"
                          IsEnabled="{Binding IsOccupied}" />
                <MenuItem Header="{x:Static res:Strings.MenuUnassign}" Command="{Binding UnassignCommand}" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Slot badge, status and XInput index -->
            <Grid MinHeight="28">
                <Border Background="{Binding SlotColor}" CornerRadius="6" Padding="12,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShortTitle}" Foreground="#071723" FontSize="15" FontWeight="Bold" AutomationProperties.Name="{Binding Title}" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Background="{DynamicResource AppBackgroundBrush}">
                        <TextBlock Text="{Binding XInputText}" FontSize="13" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Occupied: device, profile, actions -->
            <Grid Grid.Row="1" Margin="0,8,0,0" MinHeight="48" VerticalAlignment="Top" Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="{Binding DeviceType, Converter={StaticResource TypeToSymbol}}" FontSize="40"
                                       Visibility="{Binding IsKeyboard, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="28" VerticalAlignment="Center" />
                            <Path Data="{StaticResource MouseGlyph}" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" Width="16" Height="22"
                                  Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center" StrokeLineJoin="Round" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DeviceName}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasBatteryLevel, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="•" Style="{StaticResource CaptionText}" Margin="8,0" />
                                <TextBlock Text="{Binding BatteryLevelText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                <Grid Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding BatteryText}">
                                    <Border Width="21" Height="11" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="2" />
                                    <Border Width="{Binding BatteryFillWidth}" Height="7" Background="#22C55E" CornerRadius="1" HorizontalAlignment="Left" Margin="2.5,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            <!-- Occupied footer: profile and actions -->
            <StackPanel Grid.Row="2" Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Profile" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,6,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource DropButton}" MinHeight="34" Click="OnProfileClick" AutomationProperties.Name="{x:Static res:Strings.MenuChangeProfile}">
                        <Grid>
                            <TextBlock Text="{Binding ProfileName}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,24,0" />
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource ToolButton}" MinHeight="34" Margin="8,0,0,0" Click="OnAssignClick" AutomationProperties.Name="Assign device">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Assign device" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ToolButton}" MinHeight="34" Margin="8,0,0,0" MinWidth="36" Click="OnMoreClick" AutomationProperties.Name="Player options">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" />
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Empty: drop zone and actions -->
            <Grid Grid.Row="1" Margin="0,8,0,0" MinHeight="64" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                        <ui:SymbolIcon Symbol="Games24" FontSize="30" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="No device assigned" FontSize="14" />
                            <TextBlock Text="Drag a device here, or click to assign." FontSize="12" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource DropButton}" MinHeight="34" Click="OnAssignClick" AutomationProperties.Name="Assign device">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Assign device" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            </StackPanel>
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource ToolButton}" MinHeight="34" Margin="8,0,0,0" MinWidth="36" Click="OnMoreClick" AutomationProperties.Name="Player options">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
