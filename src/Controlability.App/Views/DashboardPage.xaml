<Page x:Class="Controlability.App.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:Controlability.App.Resources"
      xmlns:controls="clr-namespace:Controlability.App.Controls"
      xmlns:views="clr-namespace:Controlability.App.Views"
      xmlns:settings="clr-namespace:Controlability.Core.Settings;assembly=Controlability.Core"
      Title="{x:Static res:Strings.DashboardTitle}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="OptionMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Command" Value="{Binding Command}" />
        </Style>
        <Style x:Key="DriverChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="BannerBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="#33EF4444" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title and driver chips -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.DashboardTitle}" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource DriverChip}" Background="#333B82F6" BorderBrush="#3B82F6" Focusable="True"
                        Visibility="{Binding HasActiveGame, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="{Binding ActiveGameText}">
                    <TextBlock Text="{Binding ActiveGameText}" />
                </Border>
                <Border AutomationProperties.Name="{Binding ViGEmChipAutomationName}" Focusable="True">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource DriverChip}">
                            <Setter Property="Background" Value="#3322C55E" />
                            <Setter Property="BorderBrush" Value="#22C55E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViGEmAvailable}" Value="False">
                                    <Setter Property="Background" Value="#33EF4444" />
                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ViGEmChipText}" />
                </Border>
                <Border AutomationProperties.Name="{Binding HidHideChipAutomationName}" Focusable="True">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource DriverChip}">
                            <Setter Property="Background" Value="#3322C55E" />
                            <Setter Property="BorderBrush" Value="#22C55E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HidHideAvailable}" Value="False">
                                    <Setter Property="Background" Value="#33EF4444" />
                                    <Setter Property="BorderBrush" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding HidHideChipText}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Mode switch and pause -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.ModeLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton GroupName="KeyboardMode" Margin="0,0,8,0" MinWidth="0"
                         IsChecked="{Binding IsModeA, Mode=OneWay}"
                         Command="{Binding SetModeCommand}"
                         CommandParameter="{x:Static settings:KeyboardMode.KeyboardFirst}"
                         ToolTip="{x:Static res:Strings.ModeATooltip}" ToolTipService.ShowDuration="30000"
                         AutomationProperties.Name="{x:Static res:Strings.ModeATitle}">
                <TextBlock>
                    <Run Text="{x:Static res:Strings.ModeAShort}" FontWeight="Bold" />
                    <Run Text="{x:Static res:Strings.ModeATitle}" />
                </TextBlock>
            </RadioButton>
            <RadioButton GroupName="KeyboardMode" Margin="0,0,24,0" MinWidth="0"
                         IsChecked="{Binding IsModeB, Mode=OneWay}"
                         Command="{Binding SetModeCommand}"
                         CommandParameter="{x:Static settings:KeyboardMode.KeyboardAsController}"
                         ToolTip="{x:Static res:Strings.ModeBTooltip}" ToolTipService.ShowDuration="30000"
                         AutomationProperties.Name="{x:Static res:Strings.ModeBTitle}">
                <TextBlock>
                    <Run Text="{x:Static res:Strings.ModeBShort}" FontWeight="Bold" />
                    <Run Text="{x:Static res:Strings.ModeBTitle}" />
                </TextBlock>
            </RadioButton>
            <ui:ToggleSwitch IsChecked="{Binding IsPaused, Mode=TwoWay}" Content="{x:Static res:Strings.PauseEmulation}"
                             ToolTip="{x:Static res:Strings.PauseTooltip}" ToolTipService.ShowDuration="30000"
                             AutomationProperties.Name="{x:Static res:Strings.PauseEmulation}" />
        </WrapPanel>

        <!-- Keyboard input style (Mode B only) -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,12" IsEnabled="{Binding IsModeB}">
            <TextBlock Text="{x:Static res:Strings.KeyboardStyleLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton GroupName="KeyboardStyle" Margin="0,0,8,0" MinWidth="0"
                         IsChecked="{Binding IsStyleXbox, Mode=OneWay}"
                         Command="{Binding SetKeyboardStyleCommand}"
                         CommandParameter="{x:Static settings:KeyboardInputStyle.XboxController}"
                         Content="{x:Static res:Strings.StyleXboxShort}"
                         ToolTip="{x:Static res:Strings.StyleXboxTooltip}" ToolTipService.ShowDuration="30000"
                         AutomationProperties.Name="{x:Static res:Strings.StyleXboxShort}" />
            <RadioButton GroupName="KeyboardStyle" Margin="0,0,12,0" MinWidth="0"
                         IsChecked="{Binding IsStyleKeyboard, Mode=OneWay}"
                         Command="{Binding SetKeyboardStyleCommand}"
                         CommandParameter="{x:Static settings:KeyboardInputStyle.NormalKeyboard}"
                         Content="{x:Static res:Strings.StyleKeyboardShort}"
                         ToolTip="{x:Static res:Strings.StyleKeyboardTooltip}" ToolTipService.ShowDuration="30000"
                         AutomationProperties.Name="{x:Static res:Strings.StyleKeyboardShort}" />
            <TextBlock Text="{x:Static res:Strings.StyleOnlyModeB}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </WrapPanel>

        <!-- Driver banners -->
        <StackPanel Grid.Row="3">
            <Border x:Name="SteamTipBanner" Margin="0,0,0,12" CornerRadius="8" Padding="16,12" BorderThickness="1"
                    Background="#333B82F6" BorderBrush="#3B82F6"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SteamTipTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.SteamTipText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.SteamTipDismiss}" Command="{Binding DismissCommand}"
                            VerticalAlignment="Top" Margin="12,0,0,0" AutomationProperties.Name="{x:Static res:Strings.SteamTipDismiss}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource BannerBorder}" Visibility="{Binding ShowViGEmBanner, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.BannerViGEmTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.BannerViGEmText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="{x:Static res:Strings.BannerInstall}" Appearance="Primary"
                               VerticalAlignment="Center" Margin="16,0,0,0" Command="{Binding OpenViGEmPageCommand}"
                               ToolTip="{x:Static res:Strings.BannerInstallHint}"
                               AutomationProperties.Name="{x:Static res:Strings.BannerViGEmTitle}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource BannerBorder}" Background="#33EAB308" BorderBrush="#EAB308"
                    Visibility="{Binding ShowHidHideBanner, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.BannerHidHideTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.BannerHidHideText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="{x:Static res:Strings.BannerInstall}" Appearance="Primary"
                               VerticalAlignment="Center" Margin="16,0,0,0" Command="{Binding OpenHidHidePageCommand}"
                               ToolTip="{x:Static res:Strings.BannerInstallHint}"
                               AutomationProperties.Name="{x:Static res:Strings.BannerHidHideTitle}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Cards and detected devices -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Cards}" Drop="OnCardsDrop" AllowDrop="True" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:PlayerCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="1" CornerRadius="8" BorderThickness="1" Padding="12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{x:Static res:Strings.DetectedDevices}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.DetectedDevicesHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="DeviceList" ItemsSource="{Binding Devices}"
                             Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{x:Static res:Strings.DetectedDevices}"
                             PreviewMouseLeftButtonDown="OnDeviceMouseDown" PreviewMouseMove="OnDeviceMouseMove">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu ItemsSource="{Binding AssignOptions}"
                                                     ItemContainerStyle="{StaticResource OptionMenuItemStyle}" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding AssignmentText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <views:EmptyStateView Grid.Row="1" Symbol="PlugDisconnected24"
                                          Title="{x:Static res:Strings.DevicesEmptyTitle}"
                                          Message="{x:Static res:Strings.DevicesEmptyHint}"
                                          Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
