<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:res="clr-namespace:Controlability.App.Resources" xmlns:controls="clr-namespace:Controlability.App.Controls" xmlns:views="clr-namespace:Controlability.App.Views" xmlns:conv="clr-namespace:Controlability.App.Converters" xmlns:settings="clr-namespace:Controlability.Core.Settings;assembly=Controlability.Core" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Style="{StaticResource {x:Type Page}}" x:Class="Controlability.App.Views.DashboardPage" Title="{x:Static res:Strings.DashboardTitle}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controlability;component/Resources/DashboardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:ControllerTypeToSymbolConverter x:Key="TypeToSymbol"/>
            <Style x:Key="DriverChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="MinWidth" Value="148"/>
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            </Style>
            <Style x:Key="BannerBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Background" Value="#33EF4444"/>
                <Setter Property="BorderBrush" Value="#EF4444"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="DashSection" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            </Style>
            <!-- Blue while emulating, red while paused. Tag carries the icon colour. -->
            <Style x:Key="PauseButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                <Setter Property="Tag" Value="{DynamicResource BrandBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.88"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="3"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                        <Setter Property="Background" Value="#33EF4444"/>
                        <Setter Property="BorderBrush" Value="#EF4444"/>
                        <Setter Property="Tag" Value="#F87171"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StateDisc" TargetType="Ellipse">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Fill" Value="#22C55E"/>
            </Style>
            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <controls:FitToHeight MinScale="0.5">
        <Grid x:Name="DashboardLayout" Margin="24,14,24,14" SizeChanged="OnDashboardLayoutSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetectedColumn" Width="360"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Title, driver state and pause -->
            <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock Text="{x:Static res:Strings.DashboardTitle}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Your players, ready to play." FontSize="16" Style="{StaticResource CaptionText}"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource DriverChip}" Background="#333B82F6" BorderBrush="#3B82F6" Focusable="True" Visibility="{Binding HasActiveGame, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding ActiveGameText}">
                        <TextBlock Text="{Binding ActiveGameText}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource DriverChip}" MinWidth="0" Background="#33EF4444" BorderBrush="#EF4444" Focusable="True" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Emulation paused">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Emulation paused" FontWeight="SemiBold" Foreground="#F87171" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DriverChip}" AutomationProperties.Name="{Binding ViGEmChipAutomationName}" Focusable="True">
                        <StackPanel Orientation="Horizontal">
                            <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource StateDisc}"><Style.Triggers><DataTrigger Binding="{Binding ViGEmAvailable}" Value="False"><Setter Property="Fill" Value="#EF4444"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                <TextBlock FontWeight="Bold" Foreground="#061724" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="✓"/><Style.Triggers><DataTrigger Binding="{Binding ViGEmAvailable}" Value="False"><Setter Property="Text" Value="✗"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ViGEmBus" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ViGEmStateText}" FontSize="13"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#22C55E"/><Style.Triggers><DataTrigger Binding="{Binding ViGEmAvailable}" Value="False"><Setter Property="Foreground" Value="#EF4444"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DriverChip}" AutomationProperties.Name="{Binding HidHideChipAutomationName}" Focusable="True">
                        <StackPanel Orientation="Horizontal">
                            <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource StateDisc}"><Style.Triggers><DataTrigger Binding="{Binding HidHideAvailable}" Value="False"><Setter Property="Fill" Value="#EF4444"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                <TextBlock FontWeight="Bold" Foreground="#061724" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="✓"/><Style.Triggers><DataTrigger Binding="{Binding HidHideAvailable}" Value="False"><Setter Property="Text" Value="✗"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HidHide" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding HidHideStateText}" FontSize="13"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#22C55E"/><Style.Triggers><DataTrigger Binding="{Binding HidHideAvailable}" Value="False"><Setter Property="Foreground" Value="#EF4444"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PauseButton}" Margin="10,0,0,0" MinWidth="240" MinHeight="52" Padding="18,0" Command="{Binding TogglePauseCommand}" ToolTip="{x:Static res:Strings.PauseTooltip}" AutomationProperties.Name="{Binding PauseButtonText}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Pause24"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Symbol" Value="Play24"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="{Binding PauseButtonText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
            <!-- Mode switch -->
            <Border Grid.Row="1" Style="{StaticResource DashSection}">
                <StackPanel>
                    <TextBlock Text="Mode" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="How to interpret keyboard and mouse input." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,0,0,10"/>
                    <controls:AdaptivePanel Breakpoint="620" Gap="12">
                        <RadioButton Style="{StaticResource DashModeCard}" GroupName="KeyboardMode" IsChecked="{Binding IsModeA, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static settings:KeyboardMode.KeyboardFirst}" ToolTip="{x:Static res:Strings.ModeATooltip}" AutomationProperties.Name="{x:Static res:Strings.ModeATitle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="30" Margin="0,0,14,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="{x:Static res:Strings.ModeATitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Let multiple players use keyboard and controller devices together (recommended)." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource DashModeCard}" GroupName="KeyboardMode" IsChecked="{Binding IsModeB, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static settings:KeyboardMode.KeyboardAsController}" ToolTip="{x:Static res:Strings.ModeBTooltip}" AutomationProperties.Name="{x:Static res:Strings.ModeBTitle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="26"/>
                                    <TextBlock Text="+" FontSize="16" VerticalAlignment="Center" Margin="3,0"/>
                                    <ui:SymbolIcon Symbol="Games24" FontSize="26"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Keyboard as controller" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Emulate a controller from keyboard and mouse input (single player)." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0"/></StackPanel>
                            </Grid>
                        </RadioButton>
                    </controls:AdaptivePanel>
                </StackPanel>
            </Border>
            <!-- Keyboard input style -->
            <Border Grid.Row="2" Style="{StaticResource DashSection}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.KeyboardStyleLabel}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="With Keyboard as controller, choose how keyboard input is handled." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,0,0,10"/>
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource AppBackgroundBrush}" Padding="1">
                        <Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Style="{StaticResource SegmentLeft}" GroupName="KeyboardStyle" IsChecked="{Binding IsStyleXbox, Mode=OneWay}" Command="{Binding SetKeyboardStyleCommand}" CommandParameter="{x:Static settings:KeyboardInputStyle.XboxController}" ToolTip="{x:Static res:Strings.StyleXboxTooltip}" ToolTipService.ShowDuration="30000" AutomationProperties.Name="{x:Static res:Strings.StyleXboxShort}">
                                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Games24" FontSize="20" Margin="0,0,12,0"/><TextBlock Text="{x:Static res:Strings.StyleXboxShort}" VerticalAlignment="Center" TextWrapping="NoWrap"/></StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Column="1" Style="{StaticResource SegmentRight}" GroupName="KeyboardStyle" IsChecked="{Binding IsStyleKeyboard, Mode=OneWay}" Command="{Binding SetKeyboardStyleCommand}" CommandParameter="{x:Static settings:KeyboardInputStyle.NormalKeyboard}" ToolTip="{x:Static res:Strings.StyleKeyboardTooltip}" ToolTipService.ShowDuration="30000" AutomationProperties.Name="{x:Static res:Strings.StyleKeyboardShort}">
                                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Keyboard24" FontSize="20" Margin="0,0,12,0"/><TextBlock Text="{x:Static res:Strings.StyleKeyboardShort}" VerticalAlignment="Center" TextWrapping="NoWrap"/></StackPanel>
                                </RadioButton>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>
            <!-- Driver banners -->
            <StackPanel Grid.Row="3">
                <Border Style="{StaticResource BannerBorder}" Visibility="{Binding ShowViGEmBanner, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.BannerViGEmTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Static res:Strings.BannerViGEmText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="{x:Static res:Strings.BannerInstall}" Appearance="Primary" VerticalAlignment="Center" Margin="16,0,0,0" Command="{Binding OpenViGEmPageCommand}" ToolTip="{x:Static res:Strings.BannerInstallHint}" AutomationProperties.Name="{x:Static res:Strings.BannerViGEmTitle}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BannerBorder}" Background="#33EAB308" BorderBrush="#EAB308" Visibility="{Binding ShowHidHideBanner, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.BannerHidHideTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Static res:Strings.BannerHidHideText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="{x:Static res:Strings.BannerInstall}" Appearance="Primary" VerticalAlignment="Center" Margin="16,0,0,0" Command="{Binding OpenHidHidePageCommand}" ToolTip="{x:Static res:Strings.BannerInstallHint}" AutomationProperties.Name="{x:Static res:Strings.BannerHidHideTitle}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Cards and detected devices -->
            <ItemsControl Grid.Row="4" Grid.Column="0" ItemsSource="{Binding Cards}" Drop="OnCardsDrop" AllowDrop="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptivePanel Breakpoint="620" Gap="12" StretchRows="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:PlayerCard/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="DetectedPanel" Grid.Column="1" Grid.Row="1" Grid.RowSpan="4" Margin="12,0,0,0" CornerRadius="10" BorderThickness="1" Padding="16,14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="{x:Static res:Strings.DetectedDevices}" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="Devices connected to your system." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding RefreshDeviceListCommand}" ToolTip="Refresh" AutomationProperties.Name="Refresh devices">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20"/>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="DeviceList" ItemsSource="{Binding Devices}" Background="Transparent" VerticalAlignment="Top" Margin="-4,0" Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{x:Static res:Strings.DetectedDevices}" PreviewMouseLeftButtonDown="OnDeviceMouseDown" PreviewMouseMove="OnDeviceMouseMove">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Padding="0,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu ItemsSource="{Binding AssignOptions}">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="{Binding Header}"/>
                                                    <Setter Property="Command" Value="{Binding Command}"/>
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="{Binding Type, Converter={StaticResource TypeToSymbol}}" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding Maker}" FontSize="12" Style="{StaticResource CaptionText}" Margin="0,1,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding StatusLine}" FontSize="12" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasBatteryLevel, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="•" FontSize="12" Style="{StaticResource CaptionText}" Margin="7,0"/>
                                                <TextBlock Text="{Binding BatteryLevelText}" FontSize="12" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/>
                                                <Grid Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Border Width="21" Height="11" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="2"/>
                                                    <Border Width="{Binding BatteryFillWidth}" Height="7" Background="#22C55E" CornerRadius="1" HorizontalAlignment="Left" Margin="2.5,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" Width="104">
                                        <Border Background="{DynamicResource BrandBrush}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Stretch" Margin="0,0,0,5" Visibility="{Binding IsAssigned, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding AssignedBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="NoWrap" TextAlignment="Center"/>
                                        </Border>
                                        <Button Style="{StaticResource DropButton}" MinHeight="34" Click="OnAssignClick" AutomationProperties.Name="{Binding Name, StringFormat=Assign {0}}">
                                            <Grid>
                                                <TextBlock Text="Assign" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="SteamTipBanner" Grid.Row="2" Margin="0,10,0,0" CornerRadius="8" Padding="12,10" BorderThickness="1" Background="#2B2411" BorderBrush="#B68D17" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Ellipse Fill="#1B2838"/>
                                    <Path Stretch="Uniform" Fill="#F4F6F8" Data="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Steam detected" FontWeight="SemiBold" Foreground="#E3B341"/>
                                    <TextBlock Text="Steam is running. Make sure your controller settings match your intended layout." FontSize="13" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Static res:Strings.SteamTipText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource CaptionText}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Style="{StaticResource ToolButton}" Background="#2A313A" Padding="14,0" MinHeight="32" Command="{Binding ToggleDetailsCommand}" Content="Review setup" AutomationProperties.Name="Review setup"/>
                                <Button Style="{StaticResource GhostButton}" Padding="12,5" Margin="6,0,0,0" Command="{Binding DismissCommand}" Content="Dismiss" Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.Name="{x:Static res:Strings.SteamTipDismiss}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <views:EmptyStateView Grid.Row="1" Symbol="PlugDisconnected24" Title="{x:Static res:Strings.DevicesEmptyTitle}" Message="{x:Static res:Strings.DevicesEmptyHint}" Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </Grid>
    </controls:FitToHeight>
</Page>
