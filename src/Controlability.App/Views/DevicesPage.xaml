<Page x:Class="Controlability.App.Views.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:Controlability.App.Resources"
      xmlns:controls="clr-namespace:Controlability.App.Controls"
      xmlns:views="clr-namespace:Controlability.App.Views"
      xmlns:vm="clr-namespace:Controlability.App.ViewModels"
      Title="{x:Static res:Strings.NavDevices}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,6" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Device list -->
        <DockPanel Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.NavDevices}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.DevicesDetected}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <views:EmptyStateView DockPanel.Dock="Top" Symbol="Games24"
                                  Title="{x:Static res:Strings.DevicesEmptyTitle}" Message="{x:Static res:Strings.DevicesEmptyHint}"
                                  Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibility}}" />
            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     AutomationProperties.Name="{x:Static res:Strings.DevicesDetected}"
                     Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceDetailViewModel}">
                        <StackPanel Margin="4,4" AutomationProperties.Name="{Binding AutomationName}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding AssignmentText}" Style="{StaticResource Hint}" Margin="0,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Selected device -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DataContext="{Binding Selected}" Margin="0,0,8,0">
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.LabelType}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TypeText}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.LabelConnection}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionText}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.LabelVidPid}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VidPidText}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.LabelSerial}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SerialText}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.LabelHidPath}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HidPathText}" Style="{StaticResource FieldValue}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding HidPathText}" />
                            <TextBlock Grid.Row="5" Text="{x:Static res:Strings.LabelCapabilities}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CapabilitiesText}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="6" Text="{x:Static res:Strings.LabelAssignment}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AssignmentText}" Style="{StaticResource FieldValue}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <ui:ToggleSwitch IsChecked="{Binding IsHidden, Mode=TwoWay}" IsEnabled="{Binding CanHide}"
                                         Content="{x:Static res:Strings.HideFromGames}"
                                         AutomationProperties.Name="{x:Static res:Strings.HideFromGames}" />
                        <TextBlock Text="{x:Static res:Strings.HideFromGamesHint}" Style="{StaticResource Hint}" />
                        <TextBlock Text="{x:Static res:Strings.HidHideMissingHint}" Style="{StaticResource Hint}"
                                   Visibility="{Binding DataContext.HidHideMissing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding HasRumble, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="{x:Static res:Strings.RumbleTest}" Command="{Binding RumbleTestCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.RumbleTest}" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasLed, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.LedColor}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Static vm:DeviceDetailViewModel.LedSwatches}" Margin="0,6,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="32" Height="32" Margin="0,0,6,6" Padding="0" Background="{Binding}"
                                                ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                                Command="{Binding DataContext.SetLedCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding LedText, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="{x:Static res:Strings.LedColor}" />
                                <Button Grid.Column="1" Content="{x:Static res:Strings.LedApply}" Margin="8,0,0,0"
                                        Command="{Binding SetLedCommand}" CommandParameter="{Binding LedText}" />
                            </Grid>
                            <TextBlock Text="{Binding LedError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Live test panels: the page view model, not the selected device, is their context -->
                <Border Style="{StaticResource Section}"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:ControllerView Live="{Binding Live}" ShowOutput="False" Title="{x:Static res:Strings.LivePanelRaw}"
                                                 LeftInner="{Binding LeftInner}" LeftOuter="{Binding LeftOuter}"
                                                 RightInner="{Binding RightInner}" RightOuter="{Binding RightOuter}" />
                        <controls:ControllerView Grid.Column="2" Live="{Binding Live}" ShowOutput="True" Title="{x:Static res:Strings.LivePanelOutput}"
                                                 LeftInner="{Binding LeftInner}" LeftOuter="{Binding LeftOuter}"
                                                 RightInner="{Binding RightInner}" RightOuter="{Binding RightOuter}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
