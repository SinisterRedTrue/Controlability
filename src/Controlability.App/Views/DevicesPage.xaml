<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:res="clr-namespace:Controlability.App.Resources" xmlns:controls="clr-namespace:Controlability.App.Controls" xmlns:conv="clr-namespace:Controlability.App.Converters" xmlns:views="clr-namespace:Controlability.App.Views" xmlns:vm="clr-namespace:Controlability.App.ViewModels" x:Class="Controlability.App.Views.DevicesPage" Title="{x:Static res:Strings.NavDevices}" Style="{StaticResource {x:Type Page}}" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controlability;component/Resources/DevicesStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:ControllerTypeToSymbolConverter x:Key="TypeToSymbol"/>
            <x:Static x:Key="NotKeyboard" Member="conv:InverseBooleanToVisibilityConverter.Instance"/>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource DeviceSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DeviceEdgeBrush}"/>
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="Opacity" Value="0.7"/>
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                <Setter Property="Margin" Value="0,0,24,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="InfoValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- A larger switch than the global one, as in the design. -->
            <Style x:Key="BigSwitch" TargetType="ui:ToggleSwitch">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:ToggleSwitch">
                            <Border x:Name="Track" Width="52" Height="28" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Left" Margin="4,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource DeviceAccentBrush}"/>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource DeviceAccentBrush}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One colour of the light bar: a disc that gets a ring while it is the current colour. -->
            <Style x:Key="SwatchButton" TargetType="Button">
                <Setter Property="Width" Value="31"/>
                <Setter Property="Height" Value="31"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" Visibility="Hidden"/>
                                <Ellipse Fill="{TemplateBinding Background}" Margin="4" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource DeviceAccentBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The collapsible block inside the information card. -->
            <Style x:Key="DetailExpander" TargetType="Expander">
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource DeviceSurfaceBrush}">
                                <StackPanel>
                                    <ToggleButton x:Name="Header" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="True" FocusVisualStyle="{StaticResource KeyboardFocus}" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="12,9">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon x:Name="Chevron" Symbol="ChevronUp24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <ContentPresenter Margin="10,0,0,0" Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" TextElement.FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="False"><Setter TargetName="Chevron" Property="Symbol" Value="ChevronDown24"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <StackPanel x:Name="Body">
                                        <Border Style="{StaticResource Divider}"/>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Body" Property="Visibility" Value="Collapsed"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <controls:FitToHeight MinScale="0.65">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <Grid Margin="17,7,17,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="4,0,0,14"><TextBlock Text="{x:Static res:Strings.NavDevices}" FontSize="32" FontWeight="Bold"/><TextBlock Text="Inspect and test your connected devices." Style="{StaticResource Secondary}" FontSize="16" Margin="0,0,0,0"/></StackPanel>

            <views:EmptyStateView Grid.Row="1" Symbol="Games24" Title="{x:Static res:Strings.DevicesEmptyTitle}" Message="{x:Static res:Strings.DevicesEmptyHint}" Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibility}}"/>

            <Grid Grid.Row="1" Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="286"/>
                    <ColumnDefinition Width="11"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Device list -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Stretch" ClipToBounds="True">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Connected devices" Style="{StaticResource CardTitle}" Margin="17,11,17,10" AutomationProperties.Name="{x:Static res:Strings.DevicesDetected}"/>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Divider}"/>
                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource DeviceList}" ItemContainerStyle="{StaticResource DeviceListItem}" Margin="0,4,0,0" AutomationProperties.Name="{x:Static res:Strings.DevicesDetected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceDetailViewModel}">
                                    <Grid Margin="0,0" AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DeviceGlyph}" Width="34" Height="30" Margin="0,0,19,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding ListStatusText}" Style="{StaticResource Secondary}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Width="36" Height="40" CornerRadius="5" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPlayer, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DeviceBadgeBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DeviceAccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PlayerBadge}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Selected device -->
                <StackPanel Grid.Column="2" DataContext="{Binding Selected}">
                    <Border Style="{StaticResource Card}" Padding="24,12" Margin="0,0,0,9" MinHeight="84">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DeviceGlyph}" Width="46" Height="38" Margin="0,0,27,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource Secondary}" FontSize="15" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasBatteryLevel, Converter={StaticResource BoolToVisibility}}">
                                        <Rectangle Width="1" Height="16" Margin="14,0" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BatteryLevelText}" Style="{StaticResource Secondary}" FontSize="15" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                        <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Border Width="25" Height="13" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="2.5"/>
                                            <Border Width="{Binding BatteryFillWidth}" Height="8" Background="#22C55E" CornerRadius="1" HorizontalAlignment="Left" Margin="3.5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasPlayer, Converter={StaticResource BoolToVisibility}}">
                                        <Rectangle Width="1" Height="16" Margin="14,0" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource DeviceBadgeBrush}" CornerRadius="4" Padding="9,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlayerLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" TextWrapping="NoWrap"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <controls:AdaptivePanel Breakpoint="720" Gap="10" FirstColumnRatio="0.515" StretchRows="True" MinHeight="352">
                        <!-- Device controls -->
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Device controls" Style="{StaticResource CardTitle}" Margin="17,11,17,10"/>
                                <Border DockPanel.Dock="Top" Style="{StaticResource Divider}"/>
                                <StackPanel Margin="17,14,17,20">
                                    <StackPanel Visibility="{Binding IsKeyboard, Converter={StaticResource NotKeyboard}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Hide physical controller from games" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource BigSwitch}" Margin="12,0,0,0" IsChecked="{Binding IsHidden, Mode=TwoWay}" IsEnabled="{Binding CanHide}" AutomationProperties.Name="{x:Static res:Strings.HideFromGames}"/>
                                        </Grid>
                                        <TextBlock Text="Uses HidHide to prevent the physical controller from being detected by games, so only the virtual Xbox controller is seen." Style="{StaticResource Secondary}" FontSize="13.5" LineHeight="20" Margin="0,5,0,0"/>
                                        <TextBlock Text="{x:Static res:Strings.HidHideMissingHint}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,6,0,0" Visibility="{Binding DataContext.HidHideMissing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <TextBlock Text="Keyboard and mouse have no extra controls. Assign them to a player from the Dashboard." Style="{StaticResource Secondary}" Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibility}}"/>

                                    <StackPanel Visibility="{Binding HasRumble, Converter={StaticResource BoolToVisibility}}">
                                        <Border Style="{StaticResource Divider}" Margin="0,19,0,18"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource DeviceToolButton}" MinHeight="44" Width="187" Padding="22,0" Command="{Binding RumbleTestCommand}" AutomationProperties.Name="{x:Static res:Strings.RumbleTest}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="26" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <Path Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 9,6 A 6,6 0 0 0 9,14 M 17,6 A 6,6 0 0 1 17,14 M 5,3 A 11,11 0 0 0 5,17 M 21,3 A 11,11 0 0 1 21,17"/>
                                                    </Grid>
                                                    <TextBlock Text="Test rumble" FontSize="14" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="Trigger controller rumble to check it's working." Style="{StaticResource Secondary}" FontSize="13.5" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasLed, Converter={StaticResource BoolToVisibility}}">
                                        <Border Style="{StaticResource Divider}" Margin="0,19,0,18"/>
                                        <TextBlock Text="Light colour" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.Name="{x:Static res:Strings.LedColor}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:LedSwatchViewModel}">
                                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}" Tag="{Binding IsSelected}" ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" Command="{Binding DataContext.SetLedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Hex}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Grid.Column="1" HorizontalAlignment="Stretch" Margin="10,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border MinWidth="128" MaxWidth="140" MinHeight="40" HorizontalAlignment="Stretch" CornerRadius="6" BorderThickness="1" Background="{DynamicResource AppBackgroundBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DeviceAccentBrush}"/></Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBox Text="{Binding LedText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="8,0,0,0" MinHeight="38" VerticalContentAlignment="Center" FontSize="13" AutomationProperties.Name="{x:Static res:Strings.LedColor}"/>
                                                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="4" Margin="2,0,7,0" Background="{Binding LedPreview}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                    </Grid>
                                                </Border>
                                                <Button Grid.Column="1" Style="{StaticResource DeviceToolButton}" MinHeight="40" Padding="13,0" Margin="6,0,0,0" Content="{x:Static res:Strings.LedApply}" Command="{Binding SetLedCommand}" CommandParameter="{Binding LedText}"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Text="{Binding LedError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Device information -->
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Device information" Style="{StaticResource CardTitle}" Margin="17,11,17,10"/>
                                <Border DockPanel.Dock="Top" Style="{StaticResource Divider}"/>
                                <StackPanel Margin="11,10,11,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="146"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.LabelType}" Style="{StaticResource InfoLabel}" Margin="6,0,12,5"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TypeDescription}" Style="{StaticResource InfoValue}" Margin="6,0,0,5"/>
                                        <TextBlock Grid.Row="1" Text="{x:Static res:Strings.LabelConnection}" Style="{StaticResource InfoLabel}" Margin="6,0,12,5" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionText}" Style="{StaticResource InfoValue}" Margin="6,0,0,5" Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.LabelAssignment}" Style="{StaticResource InfoLabel}" Margin="6,0,12,5"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AssignmentValue}" Style="{StaticResource InfoValue}" Margin="6,0,0,5"/>
                                        <TextBlock Grid.Row="3" Text="{x:Static res:Strings.LabelCapabilities}" Style="{StaticResource InfoLabel}" Margin="6,0,12,5"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CapabilitiesDisplay}" Style="{StaticResource InfoValue}" Margin="6,0,0,5"/>
                                    </Grid>
                                    <Expander Header="Technical details" Visibility="{Binding IsKeyboard, Converter={StaticResource NotKeyboard}}" Style="{StaticResource DetailExpander}" Padding="18,12,14,12" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.LabelVidPid}" Style="{StaticResource InfoLabel}" FontSize="13" Margin="0,0,44,6"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VidPidText}" Style="{StaticResource InfoValue}" FontSize="13" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="1" Text="Serial number" Style="{StaticResource InfoLabel}" FontSize="13" Margin="0,0,44,6"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SerialText}" Style="{StaticResource InfoValue}" FontSize="13" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.LabelHidPath}" Style="{StaticResource InfoLabel}" FontSize="13" VerticalAlignment="Top" Margin="0,0,44,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HidPathText}" Style="{StaticResource InfoValue}" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding HidPathText}" IsHitTestVisible="True"/>
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </controls:AdaptivePanel>
                </StackPanel>
            </Grid>

            <!-- Live test panels: the page view model, not the selected device, is their context -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" MinHeight="377" Background="{DynamicResource DeviceLiveSurfaceBrush}" Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Margin="18,11,18,11">
                        <TextBlock Text="Live input test" Style="{StaticResource CardTitle}" FontSize="16"/>
                        <TextBlock Text="Press a button to see the input and output." Style="{StaticResource Secondary}" FontSize="13" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Margin="18,17,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.977*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1.023*"/>
                        </Grid.ColumnDefinitions>
                        <controls:PadDiagram Live="{Binding Live}" ShowOutput="False" Title="Physical input" Subtitle="{Binding RawTitle}" Margin="0,0,16,0" LeftInner="{Binding LeftInner}" LeftOuter="{Binding LeftOuter}" RightInner="{Binding RightInner}" RightOuter="{Binding RightOuter}">
                            <controls:PadDiagram.Style>
                                <Style TargetType="controls:PadDiagram">
                                    <Setter Property="Kind" Value="Xbox"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RawIsPlayStation}" Value="True"><Setter Property="Kind" Value="PlayStation"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:PadDiagram.Style>
                        </controls:PadDiagram>
                        <Border Grid.Column="1" Style="{StaticResource Divider}" Height="Auto" Width="1"/>
                        <controls:PadDiagram Grid.Column="2" Live="{Binding Live}" ShowOutput="True" Kind="Xbox" Title="Virtual Xbox output" Subtitle="(Xbox 360 Controller)" Margin="16,0,0,0" LeftInner="{Binding LeftInner}" LeftOuter="{Binding LeftOuter}" RightInner="{Binding RightInner}" RightOuter="{Binding RightOuter}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
    </controls:FitToHeight>
</Page>
