<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:Controlability.App.Controls" xmlns:views="clr-namespace:Controlability.App.Views" x:Class="Controlability.App.Views.ProfilesPage" Title="Profiles" PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown" Style="{StaticResource {x:Type Page}}" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controlability;component/Resources/ProfilesStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <DataTemplate x:Key="KeyRowTemplate">
                <Border Style="{StaticResource ProfileTableRow}" MinHeight="31">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36*"/>
                            <ColumnDefinition Width="34*"/>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="15*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <controls:ProfileGlyph Symbol="{Binding Control}" DockPanel.Dock="Left" Width="23" Height="23" Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                        </DockPanel>
                        <Border Grid.Column="1" Background="{DynamicResource DeviceButtonBrush}" BorderBrush="{DynamicResource DeviceEdgeBrush}" BorderThickness="1" CornerRadius="4" Padding="10,3" HorizontalAlignment="Left" Margin="0,3">
                            <TextBlock Text="{Binding DisplayKeyText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                        </Border>
                        <Button Content="Bind" Command="{Binding ChangeCommand}" Style="{StaticResource ProfileAction}" Grid.Column="2" Height="27" MinHeight="25" Margin="5,1" Padding="6,2"/>
                        <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource ProfileAction}" Grid.Column="3" Height="27" MinHeight="25" Margin="5,1" Padding="5,2"/>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ExtraRowTemplate">
                <Border Style="{StaticResource ProfileTableRow}" MinHeight="35">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28*"/>
                            <ColumnDefinition Width="25*"/>
                            <ColumnDefinition Width="25*"/>
                            <ColumnDefinition Width="22*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                        <CheckBox Style="{StaticResource ProfileToggle}" IsChecked="{Binding IsTurbo, Mode=TwoWay}" Content="" AutomationProperties.Name="IsTurbo" Grid.Column="1" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBox Grid.Column="2" Text="{Binding TurboHz, Mode=TwoWay, StringFormat=F0}" Width="110" Height="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding IsTurbo}" Padding="10,3"/>
                        <CheckBox Style="{StaticResource ProfileToggle}" IsChecked="{Binding IsToggle, Mode=TwoWay}" Content="" AutomationProperties.Name="IsToggle" Grid.Column="3" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="7,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="295" x:Name="LibraryColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource ProfileCard}" Padding="0" Margin="0,0,10,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                    <Button DockPanel.Dock="Right" Content="＋" Command="{Binding DuplicateCommand}" ToolTip="Create a copy of the selected profile" AutomationProperties.Name="Create profile copy" Width="33" Height="32" MinHeight="32" Padding="0" Margin="0,7,12,7" FontSize="24"/>
                    <TextBlock Text="Profile library" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <UniformGrid Columns="2" Rows="2" Margin="6" x:Name="LibraryTools">
                        <Button Command="{Binding ImportCommand}" Style="{StaticResource ProfileButton}" Margin="4" AutomationProperties.Name="Import">
                            <StackPanel Orientation="Horizontal">
                                <controls:ProfileGlyph Symbol="Import" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Import" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCommand}" Style="{StaticResource ProfileButton}" Margin="4" AutomationProperties.Name="Export">
                            <StackPanel Orientation="Horizontal">
                                <controls:ProfileGlyph Symbol="Export" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Export" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DuplicateCommand}" Style="{StaticResource ProfileButton}" Margin="4" AutomationProperties.Name="Duplicate">
                            <StackPanel Orientation="Horizontal">
                                <controls:ProfileGlyph Symbol="Duplicate" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Duplicate" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteCommand}" Style="{StaticResource ProfileButton}" Margin="4" ToolTip="Built-in profiles cannot be deleted" AutomationProperties.Name="Delete">
                            <StackPanel Orientation="Horizontal">
                                <controls:ProfileGlyph Symbol="Delete" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Delete" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <TextBlock Text="{Binding StatusText}" Margin="12,0,12,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" ItemContainerStyle="{StaticResource ProfileLibraryItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Profiles">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="45">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <controls:ProfileGlyph Symbol="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <views:EmptyStateView Grid.Column="1" Symbol="Document24" Title="No profiles" Message="Import a profile to get started." Visibility="{Binding HasNoEditor, Converter={StaticResource BoolToVisibility}}"/>
        <Grid Grid.Column="1" DataContext="{Binding Editor}" Visibility="{Binding DataContext.HasEditor, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ProfileCard}" Padding="11,8" CornerRadius="8,8,0,0">
                <controls:ProfileHeaderPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Profile name" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" FontSize="14"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Height="39" Background="{DynamicResource AppBackgroundBrush}" AutomationProperties.Name="Profile name" VerticalContentAlignment="Center" Padding="10,3"/>
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                        <Button Command="{Binding RevertCommand}" Style="{StaticResource ProfileButton}" Width="100" Margin="0,0,10,0" AutomationProperties.Name="Revert">
                            <StackPanel Orientation="Horizontal">
                                <controls:ProfileGlyph Symbol="Revert" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Revert" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ResetToDefaultCommand}" Style="{StaticResource ProfileButton}" Width="158" Margin="0,0,10,0" AutomationProperties.Name="Reset to default">
                            <StackPanel Orientation="Horizontal">
                                <controls:ProfileGlyph Symbol="Reset" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Reset to default" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource ProfileSave}" Width="154" Height="41" AutomationProperties.Name="Save changes">
                            <StackPanel Orientation="Horizontal">
                                <controls:ProfileGlyph Symbol="Save" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Save changes" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </controls:ProfileHeaderPanel>
            </Border>
            <TabControl Grid.Row="1" Style="{StaticResource ProfileTabs}">
                <TabItem Header="Buttons" Style="{StaticResource ProfileTab}">
                    <controls:FitToHeight MinScale="0.7" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <controls:AdaptivePanel Breakpoint="720" FirstColumnRatio=".61" Gap="12">
                                <Border Style="{StaticResource ProfileCard}" Padding="0">
                                    <StackPanel>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource DeviceEdgeBrush}" BorderThickness="0,0,0,1" Padding="14,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="31*"/>
                                                    <ColumnDefinition Width="31*"/>
                                                    <ColumnDefinition Width="38*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Xbox output" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                <TextBlock Text="Physical input" Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                                <TextBlock Text="Actions" Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding ButtonRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ProfileMappingRow}" MouseEnter="OnMappingMouseEnter">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="31*"/>
                                                                <ColumnDefinition Width="31*"/>
                                                                <ColumnDefinition Width="19*"/>
                                                                <ColumnDefinition Width="19*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource ProfileCell}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <controls:ProfileGlyph Symbol="{Binding Control}" Margin="0,0,15,0"/>
                                                                    <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center" TextWrapping="NoWrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="1" Style="{StaticResource ProfileCell}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <controls:ProfileGlyph Symbol="{Binding DisplaySource}" Margin="0,0,15,0"/>
                                                                    <TextBlock Text="{Binding DisplaySource}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Button Command="{Binding BindCommand}" Style="{StaticResource ProfileAction}" Grid.Column="2" AutomationProperties.Name="{Binding Label, StringFormat=Bind {0}}" Padding="5,2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <controls:ProfileGlyph Symbol="Bind" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                    <TextBlock Text="Bind" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding ClearCommand}" Style="{StaticResource ProfileAction}" Grid.Column="3" AutomationProperties.Name="{Binding Label, StringFormat=Clear {0}}" Padding="5,2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <controls:ProfileGlyph Symbol="Clear" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                    <TextBlock Text="Clear" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ProfileCard}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border BorderBrush="{DynamicResource DeviceEdgeBrush}" BorderThickness="0,0,0,1" Padding="16,11">
                                            <TextBlock Text="Live Xbox output" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                        <controls:ProfilePadPreview Grid.Row="1" Live="{Binding Live}" HighlightedControl="{Binding HighlightedControl}" Margin="10,28,10,26" MinHeight="300"/>
                                        <StackPanel Grid.Row="2" Margin="14,0,14,26">
                                            <Border Style="{StaticResource ProfileCard}" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock Text="ⓘ   Select Bind, then press a controller button." Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                    <TextBlock Text="      Esc cancels." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" FontSize="14"/>
                                                    <TextBlock Text="{Binding BindPrompt}" TextWrapping="Wrap" Foreground="{DynamicResource BrandBrush}" FontSize="14"/>
                                                    <Button Content="Cancel" Command="{Binding CancelBindCommand}" Visibility="{Binding IsBinding, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Currently highlighted" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="8,24,0,10" FontSize="14"/>
                                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                                <controls:ProfileGlyph Symbol="{Binding HighlightedControl}" Width="44" Height="44"/>
                                                <TextBlock Text="{Binding HighlightedControl, StringFormat={}{0} button}" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            </StackPanel>
                                            <TextBlock Text="This shows the corresponding Xbox output that will be sent when the physical input is pressed." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="22" Margin="8,14,8,24" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </controls:AdaptivePanel>
                        </ScrollViewer>
                    </controls:FitToHeight>
                </TabItem>
                <TabItem Header="Sticks" Style="{StaticResource ProfileTab}">
                    <controls:FitToHeight MinScale="0.7" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <controls:AdaptivePanel Breakpoint="720" FirstColumnRatio=".5" Gap="12">
                                    <Border Style="{StaticResource ProfileCard}">
                                        <StackPanel>
                                            <TextBlock Text="Left stick" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Configure dead zones, range and response curve for the left stick." Style="{StaticResource ProfileHint}"/>
                                            <controls:ProfileStickPreview Live="{Binding Live}" IsRight="False" Inner="{Binding LeftInner}" Outer="{Binding LeftOuter}" Margin="0,4,0,12"/>
                                            <TextBlock Text="Inner dead zone" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="0" Maximum=".9" Value="{Binding LeftInner, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="LeftInner"/>
                                                <TextBox Grid.Column="1" Text="{Binding LeftInner, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="LeftInner value" VerticalContentAlignment="Center" Padding="10,3"/>
                                            </Grid>
                                            <TextBlock Text="Input below this value will be ignored to prevent drift." Style="{StaticResource ProfileHint}"/>
                                            <TextBlock Text="Outer threshold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum=".1" Maximum="1" Value="{Binding LeftOuter, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="LeftOuter"/>
                                                <TextBox Grid.Column="1" Text="{Binding LeftOuter, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="LeftOuter value" VerticalContentAlignment="Center" Padding="10,3"/>
                                            </Grid>
                                            <TextBlock Text="Input above this value will be treated as maximum (100%)." Style="{StaticResource ProfileHint}"/>
                                            <DockPanel Margin="0,3,0,0">
                                                <TextBlock Text="Response curve" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <ComboBox ItemsSource="{Binding CurveOptions}" SelectedItem="{Binding LeftCurve, Mode=TwoWay}"/>
                                            </DockPanel>
                                            <TextBlock Text="Controls how stick input is mapped to output." Style="{StaticResource ProfileHint}"/>
                                            <TextBlock Text="Response curve (Input → Output)" Margin="0,3,0,3" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            <controls:ProfileCurveGraph Samples="{Binding LeftCurveSamples}" Height="175"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ProfileCard}">
                                        <StackPanel>
                                            <TextBlock Text="Right stick" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Configure dead zones, range and response curve for the right stick." Style="{StaticResource ProfileHint}"/>
                                            <controls:ProfileStickPreview Live="{Binding Live}" IsRight="True" Inner="{Binding RightInner}" Outer="{Binding RightOuter}" Margin="0,4,0,12"/>
                                            <TextBlock Text="Inner dead zone" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="0" Maximum=".9" Value="{Binding RightInner, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="RightInner"/>
                                                <TextBox Grid.Column="1" Text="{Binding RightInner, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="RightInner value" VerticalContentAlignment="Center" Padding="10,3"/>
                                            </Grid>
                                            <TextBlock Text="Input below this value will be ignored to prevent drift." Style="{StaticResource ProfileHint}"/>
                                            <TextBlock Text="Outer threshold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum=".1" Maximum="1" Value="{Binding RightOuter, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="RightOuter"/>
                                                <TextBox Grid.Column="1" Text="{Binding RightOuter, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="RightOuter value" VerticalContentAlignment="Center" Padding="10,3"/>
                                            </Grid>
                                            <TextBlock Text="Input above this value will be treated as maximum (100%)." Style="{StaticResource ProfileHint}"/>
                                            <DockPanel Margin="0,3,0,0">
                                                <TextBlock Text="Response curve" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <ComboBox ItemsSource="{Binding CurveOptions}" SelectedItem="{Binding RightCurve, Mode=TwoWay}"/>
                                            </DockPanel>
                                            <TextBlock Text="Controls how stick input is mapped to output." Style="{StaticResource ProfileHint}"/>
                                            <TextBlock Text="Response curve (Input → Output)" Margin="0,3,0,3" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            <controls:ProfileCurveGraph Samples="{Binding RightCurveSamples}" Height="175"/>
                                        </StackPanel>
                                    </Border>
                                </controls:AdaptivePanel>
                                <Border Style="{StaticResource ProfileCard}" Margin="0,12,0,0" Padding="18,12">
                                    <TextBlock Text="ⓘ   Move each stick to test your settings." Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </controls:FitToHeight>
                </TabItem>
                <TabItem Header="Triggers" Style="{StaticResource ProfileTab}">
                    <controls:FitToHeight MinScale="0.7" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <controls:AdaptivePanel Breakpoint="720" FirstColumnRatio=".45" Gap="12">
                                <Border Style="{StaticResource ProfileCard}" MinHeight="690">
                                    <StackPanel>
                                        <TextBlock Text="Trigger behaviour" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Style="{StaticResource ProfileDivider}"/>
                                        <TextBlock Text="Trigger dead zone" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum=".95" Value="{Binding TriggerDeadZone, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="TriggerDeadZone"/>
                                            <TextBox Grid.Column="1" Text="{Binding TriggerDeadZone, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="TriggerDeadZone value" VerticalContentAlignment="Center" Padding="10,3"/>
                                        </Grid>
                                        <TextBlock Text="0.00                                                          1.00" Style="{StaticResource ProfileHint}"/>
                                        <TextBlock Text="Ignore small accidental presses." Style="{StaticResource ProfileHint}"/>
                                        <Border Style="{StaticResource ProfileDivider}"/>
                                        <DockPanel>
                                            <CheckBox Style="{StaticResource ProfileToggle}" IsChecked="{Binding TriggerDigital, Mode=TwoWay}" Content="" AutomationProperties.Name="TriggerDigital" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Digital triggers" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </DockPanel>
                                        <TextBlock Text="Send either fully released or fully pressed." Style="{StaticResource ProfileHint}"/>
                                        <Border Style="{StaticResource ProfileDivider}"/>
                                        <TextBlock Text="Digital threshold" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <StackPanel IsEnabled="{Binding TriggerDigital}">
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum=".05" Maximum="1" Value="{Binding TriggerThreshold, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="TriggerThreshold"/>
                                                <TextBox Grid.Column="1" Text="{Binding TriggerThreshold, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="TriggerThreshold value" VerticalContentAlignment="Center" Padding="10,3"/>
                                            </Grid>
                                            <TextBlock Text="0.00                                                          1.00" Style="{StaticResource ProfileHint}"/>
                                            <TextBlock Text="Input above this point sends a full press." Style="{StaticResource ProfileHint}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Live trigger test" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Press L2 or R2 to test." Style="{StaticResource ProfileHint}"/>
                                        <controls:ProfileTriggerPreview Live="{Binding Live}" Digital="{Binding TriggerDigital}" Threshold="{Binding TriggerThreshold}" DeadZone="{Binding TriggerDeadZone}" Height="590"/>
                                    </StackPanel>
                                </Border>
                            </controls:AdaptivePanel>
                        </ScrollViewer>
                    </controls:FitToHeight>
                </TabItem>
                <TabItem Header="Keyboard &amp; mouse" Style="{StaticResource ProfileTab}">
                    <controls:FitToHeight MinScale="0.7" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <controls:AdaptivePanel Breakpoint="720" FirstColumnRatio=".75" Gap="12">
                                <StackPanel>
                                    <Border Style="{StaticResource ProfileCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Mouse settings" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <controls:AdaptivePanel Breakpoint="720" FirstColumnRatio=".5" Gap="12">
                                                <StackPanel>
                                                    <TextBlock Text="Mouse sensitivity" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                    <Grid Margin="0,4,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Minimum=".1" Maximum="5" Value="{Binding MouseSensitivity, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="MouseSensitivity"/>
                                                        <TextBox Grid.Column="1" Text="{Binding MouseSensitivity, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="MouseSensitivity value" VerticalContentAlignment="Center" Padding="10,3"/>
                                                    </Grid>
                                                    <TextBlock Text="Mouse movement drives the right stick." Style="{StaticResource ProfileHint}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Mouse decay (ms)" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                    <Grid Margin="0,4,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Minimum="10" Maximum="500" Value="{Binding DecayMs, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="DecayMs"/>
                                                        <TextBox Grid.Column="1" Text="{Binding DecayMs, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="DecayMs value" VerticalContentAlignment="Center" Padding="10,3"/>
                                                    </Grid>
                                                    <TextBlock Text="How quickly the right stick returns to center when the mouse stops moving." Style="{StaticResource ProfileHint}"/>
                                                </StackPanel>
                                            </controls:AdaptivePanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ProfileCard}">
                                        <StackPanel>
                                            <TextBlock Text="Keyboard mapping" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding CapturePrompt}" Foreground="{DynamicResource BrandBrush}" FontSize="14"/>
                                            <Button Content="Cancel" Command="{Binding CancelKeyCaptureCommand}" Style="{StaticResource ProfileButton}" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}"/>
                                            <Grid Margin="0,12,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36*"/>
                                                    <ColumnDefinition Width="34*"/>
                                                    <ColumnDefinition Width="15*"/>
                                                    <ColumnDefinition Width="15*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Xbox action" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <TextBlock Text="Keyboard or mouse" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <TextBlock Text="Bind" Grid.Column="2" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <TextBlock Text="Clear" Grid.Column="3" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding PrimaryKeyRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ProfileTableRow}" MinHeight="31">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36*"/>
                                                                    <ColumnDefinition Width="34*"/>
                                                                    <ColumnDefinition Width="15*"/>
                                                                    <ColumnDefinition Width="15*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <DockPanel>
                                                                    <controls:ProfileGlyph Symbol="{Binding Control}" DockPanel.Dock="Left" Width="23" Height="23" Margin="0,0,14,0"/>
                                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                                </DockPanel>
                                                                <Border Grid.Column="1" Background="{DynamicResource DeviceButtonBrush}" BorderBrush="{DynamicResource DeviceEdgeBrush}" BorderThickness="1" CornerRadius="4" Padding="10,3" HorizontalAlignment="Left" Margin="0,3">
                                                                    <TextBlock Text="{Binding DisplayKeyText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                                </Border>
                                                                <Button Content="Bind" Command="{Binding ChangeCommand}" Style="{StaticResource ProfileAction}" Grid.Column="2" Height="27" MinHeight="25" Margin="5,1" Padding="6,2"/>
                                                                <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource ProfileAction}" Grid.Column="3" Height="27" MinHeight="25" Margin="5,1" Padding="5,2"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Expander Header="Additional keyboard mappings" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <ItemsControl ItemsSource="{Binding AdditionalKeyRows}" ItemTemplate="{StaticResource KeyRowTemplate}"/>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Mode" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Style="{StaticResource ProfileCard}" Padding="12" Margin="0,6,0,6">
                                            <StackPanel>
                                                <TextBlock Text="⌨   Mode B" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Keyboard and mouse input is emulated as an Xbox controller using Mode B." Style="{StaticResource ProfileHint}"/>
                                        <Border Style="{StaticResource ProfileDivider}"/>
                                        <TextBlock Text="About keyboard emulation" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="Keyboard emulation listens only while a configured target game is focused." Style="{StaticResource ProfileHint}"/>
                                        <TextBlock Text="Configure target games in Settings." Style="{StaticResource ProfileHint}"/>
                                        <Border Style="{StaticResource ProfileDivider}"/>
                                        <TextBlock Text="Binding keys" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="Press Bind then a key or mouse button to assign it." Style="{StaticResource ProfileHint}"/>
                                        <TextBlock Text="Press Esc to cancel." Style="{StaticResource ProfileHint}"/>
                                    </StackPanel>
                                </Border>
                            </controls:AdaptivePanel>
                        </ScrollViewer>
                    </controls:FitToHeight>
                </TabItem>
                <TabItem Header="Extras" Style="{StaticResource ProfileTab}">
                    <controls:FitToHeight MinScale="0.7" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <controls:AdaptivePanel Breakpoint="720" FirstColumnRatio=".5" Gap="12">
                                    <Border Style="{StaticResource ProfileCard}" MinHeight="345">
                                        <StackPanel>
                                            <DockPanel>
                                                <CheckBox Style="{StaticResource ProfileToggle}" IsChecked="{Binding GyroEnabled, Mode=TwoWay}" Content="Enabled" AutomationProperties.Name="GyroEnabled" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="⊙   Gyro aiming" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </DockPanel>
                                            <TextBlock Text="Use motion to move right stick." Style="{StaticResource ProfileHint}"/>
                                            <DockPanel>
                                                <TextBlock Text="Sensitivity X" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum=".1" Maximum="5" Value="{Binding GyroSensitivityX, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="GyroSensitivityX"/>
                                                    <TextBox Grid.Column="1" Text="{Binding GyroSensitivityX, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="GyroSensitivityX value" VerticalContentAlignment="Center" Padding="10,3"/>
                                                </Grid>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="Sensitivity Y" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum=".1" Maximum="5" Value="{Binding GyroSensitivityY, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="GyroSensitivityY"/>
                                                    <TextBox Grid.Column="1" Text="{Binding GyroSensitivityY, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="GyroSensitivityY value" VerticalContentAlignment="Center" Padding="10,3"/>
                                                </Grid>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="Invert X" IsChecked="{Binding GyroInvertX}" Margin="0,7,25,7" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <CheckBox Content="Invert Y" IsChecked="{Binding GyroInvertY}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="Smoothing" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="0" Maximum="1" Value="{Binding GyroSmoothing, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="GyroSmoothing"/>
                                                    <TextBox Grid.Column="1" Text="{Binding GyroSmoothing, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="GyroSmoothing value" VerticalContentAlignment="Center" Padding="10,3"/>
                                                </Grid>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock Text="Activation" Width="145" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <ComboBox ItemsSource="{Binding GyroActivationOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding GyroActivation, Mode=TwoWay}"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock Text="Activation button" Width="145" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <ComboBox ItemsSource="{Binding GyroButtonOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding GyroButton, Mode=TwoWay}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ProfileCard}" MinHeight="345">
                                        <StackPanel>
                                            <DockPanel>
                                                <CheckBox Style="{StaticResource ProfileToggle}" IsChecked="{Binding TouchpadMouse, Mode=TwoWay}" Content="Enabled" AutomationProperties.Name="TouchpadMouse" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="▣   Touchpad mouse" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </DockPanel>
                                            <TextBlock Text="Move pointer using touchpad." Style="{StaticResource ProfileHint}"/>
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock Text="Speed" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="0" Maximum="4" Value="{Binding TouchpadSensitivity, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="TouchpadSensitivity"/>
                                                    <TextBox Grid.Column="1" Text="{Binding TouchpadSensitivity, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="TouchpadSensitivity value" VerticalContentAlignment="Center" Padding="10,3"/>
                                                </Grid>
                                            </DockPanel>
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock Text="Acceleration" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="0" Maximum="2" Value="{Binding TouchpadAcceleration, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="TouchpadAcceleration"/>
                                                    <TextBox Grid.Column="1" Text="{Binding TouchpadAcceleration, Mode=TwoWay, StringFormat=F2}" Style="{StaticResource ProfileNumber}" AutomationProperties.Name="TouchpadAcceleration value" VerticalContentAlignment="Center" Padding="10,3"/>
                                                </Grid>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </controls:AdaptivePanel>
                                <Border Style="{StaticResource ProfileCard}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="⚙   Button behaviours" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Turbo repeats while held; toggle latches a press." Style="{StaticResource ProfileHint}"/>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="14,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28*"/>
                                                    <ColumnDefinition Width="25*"/>
                                                    <ColumnDefinition Width="25*"/>
                                                    <ColumnDefinition Width="22*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Xbox button" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <TextBlock Text="Turbo enabled" Grid.Column="1" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <TextBlock Text="Rate (Hz)" Grid.Column="2" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                <TextBlock Text="Toggle enabled" Grid.Column="3" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding PrimaryExtraRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ProfileTableRow}" MinHeight="35">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28*"/>
                                                                <ColumnDefinition Width="25*"/>
                                                                <ColumnDefinition Width="25*"/>
                                                                <ColumnDefinition Width="22*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                            <CheckBox Style="{StaticResource ProfileToggle}" IsChecked="{Binding IsTurbo, Mode=TwoWay}" Content="" AutomationProperties.Name="IsTurbo" Grid.Column="1" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <TextBox Grid.Column="2" Text="{Binding TurboHz, Mode=TwoWay, StringFormat=F0}" Width="110" Height="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding IsTurbo}" Padding="10,3"/>
                                                            <CheckBox Style="{StaticResource ProfileToggle}" IsChecked="{Binding IsToggle, Mode=TwoWay}" Content="" AutomationProperties.Name="IsToggle" Grid.Column="3" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Expander Header="More button behaviours" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <ItemsControl ItemsSource="{Binding AdditionalExtraRows}" ItemTemplate="{StaticResource ExtraRowTemplate}"/>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </controls:FitToHeight>
                </TabItem>
                <TabItem Header="Applies to" Style="{StaticResource ProfileTab}">
                    <controls:FitToHeight MinScale="0.7" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <controls:AdaptivePanel Breakpoint="720" FirstColumnRatio=".72" Gap="12">
                                <StackPanel>
                                    <Border Style="{StaticResource ProfileCard}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Controller types" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Choose which controller types can use this profile." Style="{StaticResource ProfileHint}"/>
                                            <ItemsControl ItemsSource="{Binding ControllerFamilies}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,9">
                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" IsThreeState="True" Style="{StaticResource ProfileFamilyCheckBox}"/>
                                                            <controls:ProfileGlyph Symbol="{Binding Icon}" Margin="15,0,20,0"/>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Expander Header="Individual controller types" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <ItemsControl ItemsSource="{Binding ControllerTypes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="4,9">
                                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                <controls:ProfileGlyph Symbol="{Binding Type}" Margin="15,0,20,0"/>
                                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ProfileCard}">
                                        <StackPanel>
                                            <TextBlock Text="Games" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Associate this profile with game executables." Style="{StaticResource ProfileHint}"/>
                                            <ItemsControl ItemsSource="{Binding ProcessNames}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ProfileTableRow}" Padding="12,8">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                                <controls:ProfileGlyph Symbol="Document" DockPanel.Dock="Left" Margin="0,0,22,0"/>
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Style="{StaticResource ProfileDivider}"/>
                                            <TextBlock Text="Add game" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            <DockPanel>
                                                <Button Content="Browse executable…" Command="{Binding BrowseProcessCommand}" Style="{StaticResource ProfileButton}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                                                <Button Content="Add" Command="{Binding AddProcessCommand}" Style="{StaticResource ProfileButton}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                                                <TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" ToolTip="game.exe" VerticalContentAlignment="Center" Padding="10,3"/>
                                            </DockPanel>
                                            <Border Style="{StaticResource ProfileDivider}"/>
                                            <TextBlock Text="Running games" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                            <DockPanel>
                                                <Button Command="{Binding RefreshRunningAppsCommand}" Style="{StaticResource ProfileButton}" DockPanel.Dock="Right" Margin="12,0,0,0" AutomationProperties.Name="Refresh">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:ProfileGlyph Symbol="Reset" Width="18" Height="18" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                        <TextBlock Text="Refresh" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="Add selected" Command="{Binding AddSelectedProcessCommand}" Style="{StaticResource ProfileButton}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                                                <ComboBox ItemsSource="{Binding RunningApps}" SelectedItem="{Binding SelectedRunningApp, Mode=TwoWay}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource ProfileCard}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Profile summary" Style="{StaticResource ProfileHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Controller types" FontWeight="SemiBold" Margin="0,22,0,10" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                        <ItemsControl ItemsSource="{Binding ControllerFamilies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                        <controls:ProfileGlyph Symbol="{Binding Icon}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Linked games" FontWeight="SemiBold" Margin="0,24,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="{Binding ProcessNames.Count}" FontSize="22" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Style="{StaticResource ProfileDivider}"/>
                                        <TextBlock Text="Profile associations are separate from keyboard target-game settings." Style="{StaticResource ProfileHint}"/>
                                    </StackPanel>
                                </Border>
                            </controls:AdaptivePanel>
                        </ScrollViewer>
                    </controls:FitToHeight>
                </TabItem>
            </TabControl>
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,15,6">
                <TextBlock Text="{Binding ValidationText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="14" Visibility="{Binding HasValidationText, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource BrandBrush}" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="✓   Profile saved"/>
                            <Setter Property="Foreground" Value="#4AE45C"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Text" Value="Unsaved changes"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Page>