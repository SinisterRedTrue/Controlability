<Page x:Class="Controlability.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:Controlability.App.Resources"
      Title="{x:Static res:Strings.SettingsTitle}"
      PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,16">
            <TextBlock Text="{x:Static res:Strings.SettingsTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />

            <StackPanel x:Name="GeneralPanel">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Polite" />

                <!-- General -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SettingsGeneral}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Static res:Strings.StartWithWindowsHint}" Style="{StaticResource Hint}" />
                        <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="{x:Static res:Strings.StartWithWindows}"
                                         AutomationProperties.Name="{x:Static res:Strings.StartWithWindows}" />
                        <ui:ToggleSwitch IsChecked="{Binding StartMinimized, Mode=TwoWay}" Content="{x:Static res:Strings.StartMinimized}"
                                         AutomationProperties.Name="{x:Static res:Strings.StartMinimized}" />
                        <TextBlock Text="{x:Static res:Strings.CloseToTrayHint}" Style="{StaticResource Hint}" Margin="0,8,0,8" />
                        <ui:ToggleSwitch IsChecked="{Binding DataContext.CloseToTray, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                                         Content="{x:Static res:Strings.CloseToTray}"
                                         AutomationProperties.Name="{x:Static res:Strings.CloseToTray}" />
                        <TextBlock Text="{x:Static res:Strings.ModeSettingLabel}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding Mode}" DisplayMemberPath="Label"
                                  HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="{x:Static res:Strings.ModeSettingLabel}" />
                    </StackPanel>
                </Border>

                <!-- Input -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SettingsInput}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Static res:Strings.SlotPolicyLabel}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBlock Text="{x:Static res:Strings.SlotPolicyHint}" Style="{StaticResource Hint}" />
                        <ComboBox ItemsSource="{Binding SlotPolicyChoices}" SelectedItem="{Binding SlotPolicyChoice}" DisplayMemberPath="Label"
                                  HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="{x:Static res:Strings.SlotPolicyLabel}" />
                        <TextBlock Text="{x:Static res:Strings.PollingRateLabel}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock Text="{x:Static res:Strings.PollingRateHint}" Style="{StaticResource Hint}" />
                        <ComboBox ItemsSource="{Binding PollingRateChoices}" SelectedItem="{Binding PollingRate}" DisplayMemberPath="Label"
                                  HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="{x:Static res:Strings.PollingRateLabel}" />
                        <TextBlock Text="{x:Static res:Strings.GraceLabel}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock Text="{x:Static res:Strings.GraceHint}" Style="{StaticResource Hint}" />
                        <ComboBox ItemsSource="{Binding GracePeriodChoices}" SelectedItem="{Binding GracePeriod}" DisplayMemberPath="Label"
                                  HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="{x:Static res:Strings.GraceLabel}" />
                    </StackPanel>
                </Border>

                <!-- Hiding -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SettingsHiding}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Static res:Strings.HidHideHint}" Style="{StaticResource Hint}" />
                        <ui:ToggleSwitch IsChecked="{Binding HidHideEnabled, Mode=TwoWay}" Content="{x:Static res:Strings.HidHideEnabled}"
                                         AutomationProperties.Name="{x:Static res:Strings.HidHideEnabled}" />
                        <ui:ToggleSwitch IsChecked="{Binding UnhideWhilePaused, Mode=TwoWay}" Content="{x:Static res:Strings.UnhideWhilePaused}"
                                         AutomationProperties.Name="{x:Static res:Strings.UnhideWhilePaused}" />
                        <TextBlock Text="{x:Static res:Strings.UnhideAllHint}" Style="{StaticResource Hint}" Margin="0,8,0,8" />
                        <Button Content="{x:Static res:Strings.UnhideAllButton}" Command="{Binding UnhideAllCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SettingsAppearance}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Static res:Strings.ThemeLabel}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" DisplayMemberPath="Label"
                                  HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="{x:Static res:Strings.ThemeLabel}" />
                        <TextBlock Text="{x:Static res:Strings.LanguageLabel}" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language}" DisplayMemberPath="Label"
                                  HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="{x:Static res:Strings.LanguageLabel}" />
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SettingsAdvanced}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Static res:Strings.LogLevelLabel}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding LogLevelChoices}" SelectedItem="{Binding LogLevel}" DisplayMemberPath="Label"
                                  HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="{x:Static res:Strings.LogLevelLabel}" />
                        <TextBlock Text="{Binding LogsFolder}" Style="{StaticResource Hint}" Margin="0,8,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static res:Strings.OpenLogs}" Command="{Binding OpenLogsCommand}" />
                            <Button Content="{x:Static res:Strings.CopyDiagnostics}" Command="{Binding CopyDiagnosticsCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SettingsAbout}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding VersionText}" Margin="0,8,0,4" />
                        <TextBlock Text="{x:Static res:Strings.AboutLicenses}" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <ItemsControl ItemsSource="{Binding Notices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding License}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="{x:Static res:Strings.AboutOpen}"
                                                Command="{Binding DataContext.OpenLinkCommand, ElementName=GeneralPanel}"
                                                CommandParameter="{Binding Url}" AutomationProperties.Name="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Game for Mode B -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.SettingsGameTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{x:Static res:Strings.SettingsGameHint}" Style="{StaticResource Hint}" />

                    <TextBlock Text="{x:Static res:Strings.GameNone}" Style="{StaticResource Hint}"
                               Visibility="{Binding HasNoTargets, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding TargetProcesses}" Margin="0,0,0,8"
                                  Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.GameRemove}"
                                            Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{x:Static res:Strings.GameNameHint}"
                                    AutomationProperties.Name="{x:Static res:Strings.GameNameHint}" />
                        <Button Grid.Column="1" Content="{x:Static res:Strings.GameAdd}" Margin="8,0,0,0"
                                Command="{Binding AddProcessCommand}" />
                    </Grid>

                    <TextBlock Text="{x:Static res:Strings.GameRunning}" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding RunningApps}" SelectedItem="{Binding SelectedRunningApp}"
                                  AutomationProperties.Name="{x:Static res:Strings.GameRunning}" />
                        <Button Grid.Column="1" Content="{x:Static res:Strings.GameAddSelected}" Margin="8,0,0,0"
                                Command="{Binding AddSelectedProcessCommand}" />
                        <Button Grid.Column="2" Content="{x:Static res:Strings.GameRefresh}" Margin="8,0,0,0"
                                Command="{Binding RefreshRunningAppsCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Keyboard keys -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.SettingsKeysTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{x:Static res:Strings.SettingsKeysHint}" Style="{StaticResource Hint}" />
                    <TextBlock Text="{Binding KeyboardProfileText}" Style="{StaticResource Hint}" />

                    <Grid Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CapturePrompt}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <Button Grid.Column="1" Content="{x:Static res:Strings.KeyCancel}" Command="{Binding CancelCaptureCommand}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.ColXbox}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ColKeyboard}" FontWeight="SemiBold" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding KeyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding KeyText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="2" Content="{x:Static res:Strings.KeyChange}" Margin="8,0,0,0"
                                            Command="{Binding ChangeCommand}" AutomationProperties.Name="{Binding Label}" />
                                    <Button Grid.Column="3" Content="{x:Static res:Strings.KeyClear}" Margin="8,0,0,0"
                                            Command="{Binding ClearCommand}" AutomationProperties.Name="{Binding Label}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{x:Static res:Strings.KeysReset}" Command="{Binding ResetKeysCommand}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Controller buttons -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.SettingsPadTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{x:Static res:Strings.SettingsPadHint}" Style="{StaticResource Hint}" />
                    <TextBlock Text="{Binding ControllerSummary}" Style="{StaticResource Hint}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.ColXbox}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ColController}" FontWeight="SemiBold" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ControllerRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Button}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
