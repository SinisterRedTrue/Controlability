<?xml version="1.0" ?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:res="clr-namespace:Controlability.App.Resources" xmlns:controls="clr-namespace:Controlability.App.Controls" xmlns:views="clr-namespace:Controlability.App.Views" x:Class="Controlability.App.Views.SettingsPage" Title="Settings" PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown" Style="{StaticResource {x:Type Page}}" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controlability;component/Resources/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <CollectionViewSource x:Key="KeyboardPreviewRows" Source="{Binding KeyRows}" Filter="OnKeyboardPreviewFilter"/>
            <CollectionViewSource x:Key="ControllerPreviewRows" Source="{Binding ControllerRows}" Filter="OnControllerPreviewFilter"/>
            <views:SettingsDisplayConverter x:Key="SettingsDisplay"/>
            <DataTemplate x:Key="SettingsActionIcon">
                <Grid Width="26" Height="26">
                    <controls:ProfileGlyph x:Name="Symbol" Symbol="{Binding Label}" Width="26" Height="26"/>
                    <Ellipse x:Name="Face" Fill="#45B63F" Visibility="Collapsed"/>
                    <TextBlock x:Name="Letter" Text="{Binding Label}" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Label}" Value="A">
                        <Setter TargetName="Symbol" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Face" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Letter" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Label}" Value="B">
                        <Setter TargetName="Symbol" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Face" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Face" Property="Fill" Value="#F52C42"/>
                        <Setter TargetName="Letter" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate x:Key="SettingsChoiceLabel">
                <TextBlock Text="{Binding Label, Converter={StaticResource SettingsDisplay}, ConverterParameter=Choice}" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap"/>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="8,20,15,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsIndexColumn" Width="153"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="18,0,0,20">
            <TextBlock Text="Settings" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="30" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock Text="Configure how Controlability works. Changes take effect immediately." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Padding="2,5" Margin="0,2,13,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SettingsIndex">
                    <Button Content="General" Style="{StaticResource SettingsNavigation}" Tag="SettingsSection0" Click="OnSectionClick" Selector.IsSelected="True"/>
                    <Button Content="Input" Style="{StaticResource SettingsNavigation}" Tag="SettingsSection1" Click="OnSectionClick"/>
                    <Button Content="Hiding" Style="{StaticResource SettingsNavigation}" Tag="SettingsSection2" Click="OnSectionClick"/>
                    <Button Content="Appearance" Style="{StaticResource SettingsNavigation}" Tag="SettingsSection3" Click="OnSectionClick"/>
                    <Button Content="Target games" Style="{StaticResource SettingsNavigation}" Tag="SettingsSection6" Click="OnSectionClick"/>
                    <Button Content="Keyboard mappings" Style="{StaticResource SettingsNavigation}" Tag="SettingsSection7" Click="OnSectionClick"/>
                    <Button Content="Controller reference" Style="{StaticResource SettingsNavigation}" Tag="SettingsSection8" Click="OnSectionClick"/>
                    <Button Content="Advanced" Style="{StaticResource SettingsNavigation}" Tag="SettingsSection4" Click="OnSectionClick"/>
                    <Button Content="About" Style="{StaticResource SettingsNavigation}" Tag="SettingsSection5" Click="OnSectionClick"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding DataContext.StatusText, ElementName=GeneralPanel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,0,0,12"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <controls:AdaptivePanel x:Name="GeneralPanel" Breakpoint="600" FirstColumnRatio="0.484" Gap="14">
                    <StackPanel>
                        <Border x:Name="SettingsSection0" Style="{StaticResource SettingsCard}" MinHeight="318">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Text="Configure application behaviour." Style="{StaticResource SettingsIntro}"/>
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" DockPanel.Dock="Right" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="Start with Windows"/>
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Launch Controlability when Windows starts." Style="{StaticResource SettingsHint}" FontSize="12" LineHeight="17"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding StartMinimized, Mode=TwoWay}" DockPanel.Dock="Right" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="Start minimized"/>
                                    <StackPanel>
                                        <TextBlock Text="Start minimized" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Start the application minimized to the tray." Style="{StaticResource SettingsHint}" FontSize="12" LineHeight="17"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding DataContext.CloseToTray, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}" DockPanel.Dock="Right" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="Close to tray"/>
                                    <StackPanel>
                                        <TextBlock Text="Close to tray" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Minimize to tray instead of closing." Style="{StaticResource SettingsHint}" FontSize="12" LineHeight="17"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <TextBlock Text="Keyboard mode" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                <TextBlock Text="Control how keyboard input is emulated." Style="{StaticResource SettingsHint}" Margin="0,3,0,7"/>
                                <ComboBox ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding Mode, Mode=TwoWay}" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Keyboard mode" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource SettingsChoiceLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsSection2" Style="{StaticResource SettingsCard}" MinHeight="290">
                            <StackPanel>
                                <TextBlock Text="Hiding" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Text="Control the visibility of physical controllers." Style="{StaticResource SettingsIntro}" Margin="0,4,0,8"/>
                                <DockPanel Margin="0,0,0,6">
                                    <CheckBox IsChecked="{Binding HidHideEnabled, Mode=TwoWay}" DockPanel.Dock="Right" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="Hide physical controllers"/>
                                    <StackPanel>
                                        <TextBlock Text="Hide physical controllers" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Prevent physical controllers from being seen by games (use virtual controllers instead)." Style="{StaticResource SettingsHint}" FontSize="12" LineHeight="17"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <CheckBox IsChecked="{Binding UnhideWhilePaused, Mode=TwoWay}" DockPanel.Dock="Right" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="Show controllers while paused"/>
                                    <StackPanel>
                                        <TextBlock Text="Show controllers while paused" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Temporarily show physical controllers when the application is paused." Style="{StaticResource SettingsHint}" FontSize="12" LineHeight="17"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource SettingsDivider}"/>
                                <TextBlock Text="Unhide all controllers" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                <TextBlock Text="Make all previously hidden controllers visible again." Style="{StaticResource SettingsHint}" Margin="0,3,0,7"/>
                                <Button Content="Unhide all controllers" Command="{Binding UnhideAllCommand}" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsSection6" Style="{StaticResource SettingsCard}" MinHeight="306" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                            <StackPanel>
                                <TextBlock Text="Target games" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Text="Keyboard emulation listens only when a listed game has focus." Style="{StaticResource SettingsIntro}" Margin="0,4,0,8"/>
                                <ItemsControl ItemsSource="{Binding TargetProcesses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource DeviceSurfaceBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,7">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SettingsButton}" Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Width="78"/>
                                                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No target games configured." Style="{StaticResource SettingsHint}" Visibility="{Binding HasNoTargets, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8"/>
                                <TextBlock Text="Add game by process name" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" Margin="0,4,0,4"/>
                                <DockPanel>
                                    <Button Content="Add" Command="{Binding AddProcessCommand}" Style="{StaticResource SettingsButton}" DockPanel.Dock="Right" Margin="10,0,0,0" Width="70"/>
                                    <ui:TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="game.exe" AutomationProperties.Name="Game process name" Style="{StaticResource SettingsEntry}"/>
                                </DockPanel>
                                <TextBlock Text="Add from running process" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" Margin="0,12,0,4"/>
                                <DockPanel>
                                    <Button Content="Add selected" Command="{Binding AddSelectedProcessCommand}" Style="{StaticResource SettingsButton}" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                                    <ComboBox x:Name="RunningProcesses" ItemsSource="{Binding RunningApps}" SelectedItem="{Binding SelectedRunningApp, Mode=TwoWay}" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Select a running process" HorizontalContentAlignment="Stretch" Tag="Select a running process…"/>
                                </DockPanel>
                                <Button Content="Refresh" Command="{Binding RefreshRunningAppsCommand}" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="0,8,0,0" MinWidth="90"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsSection8" Style="{StaticResource SettingsCard}" MinHeight="294" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0" ToolTip="{Binding ControllerSummary}">
                            <StackPanel>
                                <TextBlock Text="Controller reference" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Text="View how Xbox actions map to common physical controllers." Style="{StaticResource SettingsIntro}" FontSize="11.5" LineHeight="16" Margin="0,4,0,8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="View how Xbox actions map to common physical controllers."/>
                                <Expander x:Name="ControllerPreview" Header="Controller mapping preview" Style="{StaticResource SettingsExpander}">
                                    <StackPanel>
                                        <Border Background="{DynamicResource DeviceButtonBrush}" BorderBrush="{DynamicResource DeviceEdgeBrush}" BorderThickness="0,1,0,0">
                                            <Grid MinHeight="32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32*"/>
                                                    <ColumnDefinition Width="68*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource SettingsTableCell}">
                                                    <TextBlock Text="Xbox action" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding ControllerRows[0].Button, Converter={StaticResource SettingsDisplay}, ConverterParameter=Header}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Grid.Column="1" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" Margin="14,0,5,0"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl x:Name="ReferenceRows" ItemsSource="{Binding Source={StaticResource ControllerPreviewRows}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SettingsTableRow}" MinHeight="41">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32*"/>
                                                                <ColumnDefinition Width="68*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource SettingsTableCell}">
                                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsActionIcon}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Button, Converter={StaticResource SettingsDisplay}, ConverterParameter=Physical}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="20,4,8,4"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                                <Button Content="View full reference" Style="{StaticResource SettingsLink}" x:Name="ShowReferenceButton" Click="OnShowReferenceClick" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <Border x:Name="SettingsSection1" Style="{StaticResource SettingsCard}" MinHeight="318">
                            <StackPanel>
                                <TextBlock Text="Input" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Text="Configure input and connection settings." Style="{StaticResource SettingsIntro}"/>
                                <Grid Margin="0,2,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Player slots" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="How controllers are assigned to players." Style="{StaticResource SettingsHint}"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding SlotPolicyChoices}" SelectedItem="{Binding SlotPolicyChoice, Mode=TwoWay}" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Player slots" Grid.Column="1" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource SettingsChoiceLabel}"/>
                                </Grid>
                                <Grid Margin="0,2,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Polling rate" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Rate at which input is sent to games." Style="{StaticResource SettingsHint}"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding PollingRateChoices}" SelectedItem="{Binding PollingRate, Mode=TwoWay}" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Polling rate" Grid.Column="1" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource SettingsChoiceLabel}"/>
                                </Grid>
                                <Grid Margin="0,2,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Bluetooth grace period" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Keep the player slot during brief Bluetooth disconnects." Style="{StaticResource SettingsHint}"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding GracePeriodChoices}" SelectedItem="{Binding GracePeriod, Mode=TwoWay}" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Bluetooth grace period" Grid.Column="1" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource SettingsChoiceLabel}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsSection3" Style="{StaticResource SettingsCard}" MinHeight="290">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Text="Customize the look and language." Style="{StaticResource SettingsIntro}"/>
                                <Grid Margin="0,2,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Theme" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Application theme." Style="{StaticResource SettingsHint}"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme, Mode=TwoWay}" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Theme" Grid.Column="1" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource SettingsChoiceLabel}"/>
                                </Grid>
                                <Grid Margin="0,2,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Language" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Application language." Style="{StaticResource SettingsHint}"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language, Mode=TwoWay}" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Language" Grid.Column="1" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource SettingsChoiceLabel}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsSection7" Style="{StaticResource SettingsCard}" MinHeight="268" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}" ToolTip="{Binding KeyboardProfileText}">
                            <StackPanel>
                                <TextBlock Text="Keyboard mappings" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Text="Map keyboard keys to controller actions." Style="{StaticResource SettingsIntro}" Margin="0,4,0,11"/>
                                <StackPanel IsEnabled="{Binding HasKeyboardProfile}">
                                    <Grid Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CapturePrompt}" Foreground="{DynamicResource BrandBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                                        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCaptureCommand}" Style="{StaticResource SettingsButton}"/>
                                    </Grid>
                                    <Expander x:Name="KeyboardPreview" Header="Mapping preview (Xbox)" Style="{StaticResource SettingsExpander}">
                                        <StackPanel>
                                            <Border Background="{DynamicResource DeviceButtonBrush}" BorderBrush="{DynamicResource DeviceEdgeBrush}" BorderThickness="0,1,0,0">
                                                <Grid Height="30">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30*"/>
                                                        <ColumnDefinition Width="27*"/>
                                                        <ColumnDefinition Width="24*"/>
                                                        <ColumnDefinition Width="19*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SettingsTableCell}">
                                                        <TextBlock Text="Xbox action" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource SettingsTableCell}">
                                                        <TextBlock Text="Key" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource SettingsTableCell}">
                                                        <TextBlock Text="Change" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Column="3" Style="{StaticResource SettingsTableCell}">
                                                        <TextBlock Text="Clear" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ItemsControl x:Name="KeyboardRows" ItemsSource="{Binding Source={StaticResource KeyboardPreviewRows}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource SettingsTableRow}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30*"/>
                                                                    <ColumnDefinition Width="27*"/>
                                                                    <ColumnDefinition Width="24*"/>
                                                                    <ColumnDefinition Width="19*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Style="{StaticResource SettingsTableCell}">
                                                                    <DockPanel>
                                                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsActionIcon}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                </Border>
                                                                <Border Grid.Column="1" Style="{StaticResource SettingsTableCell}">
                                                                    <TextBlock Text="{Binding KeyText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Border Grid.Column="2" Style="{StaticResource SettingsTableCell}" Padding="6,4">
                                                                    <Button Content="Change" Command="{Binding ChangeCommand}" Style="{StaticResource SettingsButton}" AutomationProperties.Name="{Binding Label, StringFormat=Change {0}}" Padding="5,3"/>
                                                                </Border>
                                                                <Border Grid.Column="3" Padding="6,4">
                                                                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SettingsButton}" AutomationProperties.Name="{Binding Label, StringFormat=Clear {0}}" Padding="5,3"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                    <DockPanel Margin="0,12,0,0">
                                        <Button Content="Reset mappings" Command="{Binding ResetKeysCommand}" Style="{StaticResource SettingsButton}" DockPanel.Dock="Left"/>
                                        <Button Content="View all mappings" Style="{StaticResource SettingsLink}" x:Name="ShowMappingsButton" Click="OnShowMappingsClick" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsSection4" Style="{StaticResource SettingsCard}" MinHeight="180" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Advanced" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Text="Advanced configuration and troubleshooting." Style="{StaticResource SettingsIntro}" Margin="0,4,0,3"/>
                                <Grid Margin="0,-5,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Log level" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
                                        <TextBlock Text="Amount of detail written to the log." Style="{StaticResource SettingsHint}" FontSize="11.5" Margin="0,2,12,0"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding LogLevelChoices}" SelectedItem="{Binding LogLevel, Mode=TwoWay}" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Log level" Grid.Column="1" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource SettingsChoiceLabel}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Open logs" Command="{Binding OpenLogsCommand}" Style="{StaticResource SettingsButton}" Padding="8,4" ToolTip="{Binding LogsFolder}"/>
                                    <TextBlock Text="Open the application log folder." Style="{StaticResource SettingsHint}" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" Style="{StaticResource SettingsButton}" Padding="8,4"/>
                                    <TextBlock Text="Copy diagnostic information to clipboard." Style="{StaticResource SettingsHint}" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsSection5" Style="{StaticResource SettingsCard}" MinHeight="144" Padding="14,6" Margin="0">
                            <StackPanel>
                                <TextBlock Text="About" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Text="Information about Controlability and third-party licences." Style="{StaticResource SettingsIntro}" FontSize="11.5" LineHeight="16" Margin="0,2,0,2"/>
                                <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,0,2"/>
                                <DockPanel>
                                    <Button Content="Open" Style="{StaticResource SettingsButton}" x:Name="ShowLicencesButton" DockPanel.Dock="Right" Click="OnShowLicencesClick" Width="88" Height="24" MinHeight="24" Padding="8,2"/>
                                    <TextBlock Text="Third-party licences" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="LicencesPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding Notices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SettingsTableRow}" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding License}" Style="{StaticResource SettingsHint}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Open" Style="{StaticResource SettingsButton}" Command="{Binding DataContext.OpenLinkCommand, ElementName=GeneralPanel}" CommandParameter="{Binding Url}" AutomationProperties.Name="{Binding Name}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Border Style="{StaticResource SettingsDivider}" Margin="0,1,0,6"/>
                                <DockPanel>
                                    <Button Content="Uninstall" Command="{Binding UninstallCommand}" Style="{StaticResource SettingsDanger}" DockPanel.Dock="Right" Width="88" ToolTip="{Binding UninstallAvailable, Converter={StaticResource SettingsDisplay}, ConverterParameter=Uninstall}" ToolTipService.ShowOnDisabled="True"/>
                                    <StackPanel>
                                        <TextBlock Text="Uninstall" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Remove Controlability from your system." Style="{StaticResource SettingsHint}" FontSize="12" Margin="0,2,8,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:AdaptivePanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>